
//
// Test/development users used by the test suite and docker-compose.
// "regular_user" is the unprivileged test user; "admin" is the admin test user.
// ADMIN_USERNAMES in docker-compose.yml must include "admin" for the admin tests to pass.
//
db.getSiblingDB("iris").users.insertOne({
  "username": "regular_user",
  "uidnumber": 99001,
  "eppns": [ "regular_user@example.com" ],
  "shell": "/bin/bash",
  "preferredemail": "regular_user@example.com"
})
db.getSiblingDB("iris").users.insertOne({
  "username": "admin",
  "uidnumber": 99002,
  "eppns": [ "admin@example.com" ],
  "shell": "/bin/bash",
  "preferredemail": "admin@example.com"
})
// "user-lookup-bot" is the posix sync service account (POSIX_SYNC_USERNAMES must include it). As in the real
// deployments it is a plain user, not isbot: bots are implicit admins, which IsPosixSyncAccount deliberately avoids.
db.getSiblingDB("iris").users.insertOne({
  "username": "user-lookup-bot",
  "uidnumber": 99003,
  "eppns": [ "user-lookup-bot@example.com" ],
  "shell": "/bin/bash",
  "preferredemail": "user-lookup-bot@example.com"
})
// "test-bot" is a bot user, used to check that bots are excluded from the posix sync.
db.getSiblingDB("iris").users.insertOne({
  "username": "test-bot",
  "uidnumber": 99004,
  "eppns": [ "test-bot@example.com" ],
  "shell": "/bin/bash",
  "preferredemail": "test-bot@example.com",
  "isbot": true
})

// Create clusters
db.getSiblingDB("iris").clusters.insertOne({
  "name": "roma",
  "nodecpucount": 128,
  "nodecpucountdivisor": 64,
  "nodememgb": 512,
  "chargefactor": 0.8,
  "nodecpusmt": 1,
  "members": []
});
for(c=0;c<32;c++) {
  db.getSiblingDB("iris").clusters.updateOne({"name": "roma"}, {"$addToSet": {"members": "sdfrome"+String(c).padStart(4,'0')}});
}

db.getSiblingDB("iris").clusters.insertOne({
  "name": "milano",
  "nodecpucount": 128,
  "nodecpucountdivisor": 16,
  "nodememgb": 512,
  "chargefactor": 0.8,
  "nodecpusmt": 1,
  "members": []
});
for(c=0;c<28;c++) {
  db.getSiblingDB("iris").clusters.updateOne({"name": "milano"}, {"$addToSet": {"members": "sdfmilan"+String(c).padStart(4,'0')}});
}

// Create physical volumes
db.getSiblingDB("iris").physical_volumes.insertOne({
  "name": "sdfhome",
  "storageclass": "ssd",
  "gigabytes": 2000000000,
  "inodes": 100000000
});

db.getSiblingDB("iris").physical_volumes.insertOne({
  "name": "sdfdata",
  "storageclass": "ssd",
  "gigabytes": 4000000000,
  "inodes": 1000000000
});
